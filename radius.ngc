;radius

O<radius> sub

G8 ; Lathe radius Mode
G18 ; XZ Plane
G21 ; Metric Units
G90 ; Absolute Distance


O70 IF [#5400 NE #6]
#420 = #5420
#422 = #5422
M6 T#6 G43
G0 X#420 Z#422
O70 ENDIF

#1 = [#1 / 2] ; because of radius mode
#16 = [#<_x>] (starting X)
#15 = [#<_z>] (starting Z)

G96 D2400 S#2 ; Constant Surface Speed Mode

O80 IF [#13 LT 0.5]
m3 ;Start Spindle normal direction
O80 ELSE
m4 ;Start spindle opposite direction
O80 ENDIF

g95 F0.1 ; Feed-Per-Rev Mode

O90 IF [#12 GT 0.5]
	M8
O90 ENDIF

#20 = 0
O101 if [#9 GT 0.5] ; Front outside
	o100 while [[#20 + #3] lt #8]
	#20 = [#20 + #3]
	g0 x[#1 - #20] z#15
	g1 z#5
	g3 x#1 z[#5 - #20] K[-#20]
	g1 x #16
	g0 z#15
	o100 endwhile
	g0 x#16 z#15
	g0 x[#1 - #8]
	g1 z#5
	g3 x#1 z[#5 - #8] K[-#8]
	g1 x #16
	g0 z#15
O101 elseif [#10 GT 0.5] ; front inside
	o102 while [[#20 + #3] lt #8]
	#20 = [#20 + #3]
	g0 x[#1 + #20] z#15
	g1 z#5
	g2 x#1 z[#5 - #20] K[-#20]
	g1 x #16
	g0 z#15
	o102 endwhile
	g0 x#16 z#15
	g0 x[#1 + #8]
	g1 z#5
	g2 x#1 z[#5 - #8] K[-#8]
	g1 x #16
	g0 z#15
O101 elseif [#11 GT 0.5] ; back outside
	o103 while [[#20 + #3] lt #8]
	#20 = [#20 + #3]
	g0 x[#1 - #20] z#15
	g1 z#5
	g2 x#1 z[#5 + #20] K#20
	g1 x #16
	g0 z#15
	o103 endwhile
	g0 x#16 z#15
	g0 x[#1 - #8]
	g1 z#5
	g2 x#1 z[#5 + #8] K#8
	g1 x #16
	g0 z#15
O101 endif
M5 M9
G7
O<radius> endsub
m2
%
